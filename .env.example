# AI screening — provider is a config value, never hardcoded (Section 2)
# Leave everything unset to use the deterministic offline "heuristic" screener.
AI_PROVIDER=heuristic            # heuristic | groq | cloudflare
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.1-8b-instant

# Endpoint rate limit: submissions per IP per hour (Section 10)
SUBMISSION_RATE_LIMIT=10

# Supabase — service key server-side only; anon role is INSERT-only on queues
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Admin review queue (/admin) — set to enable; token sent via x-admin-token
ADMIN_TOKEN=

# Trust guardrail: only set true after the seed dataset has been
# packaging-verified item by item. Until then the UI shows a pending-verification notice.
SEED_DATA_VERIFIED=false

