# Cloudflare Pages headers — mirrors next.config.ts headers so the
# security policy holds even if a route bypasses Next header injection.
/
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.openfoodfacts.org https://*.openfoodfacts.org https://upload.wikimedia.org; connect-src 'self' https://world.openfoodfacts.org; media-src 'self' blob:; font-src 'self' data:; frame-ancestors 'none'
/api/*
  Cache-Control: no-store
